rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Audit logs, medical records, and inventory are strictly restricted
    match /medical_records/{document} {
      allow read, write: if request.auth != null && (request.auth.token.role == 'MEDICAL_OFFICER' || request.auth.token.role == 'SUPER_ADMIN');
    }
    match /audit_logs/{document} {
      allow read: if request.auth != null && request.auth.token.role == 'SUPER_ADMIN';
      allow write: if false; // Server-side admin only
    }
    match /inventory/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
